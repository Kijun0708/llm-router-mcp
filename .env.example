# LLM Router MCP 환경 설정

# === 선택 ===
# Exa API 키 (웹 검색) - https://exa.ai 에서 발급
# EXA_API_KEY=your_exa_api_key_here

# Context7 API 키 (라이브러리 문서) - https://context7.com 에서 발급
# CONTEXT7_API_KEY=your_context7_api_key_here

# === CLI 도구 경로 (기본값 사용 시 생략 가능) ===
# 터미널에 이미 설치된 CLI 도구의 경로 (PATH에 있으면 생략 가능)
# CLI_GEMINI_PATH=gemini
# CLI_CLAUDE_PATH=claude
# CLI_CODEX_PATH=codex

# === 캐시 설정 (기본값 사용 시 생략 가능) ===
# CACHE_ENABLED=true
# CACHE_TTL_MS=1800000
# CACHE_MAX_SIZE=100

# === 재시도 설정 (기본값 사용 시 생략 가능) ===
# RETRY_MAX=3
# RETRY_BASE_DELAY_MS=1000
# RETRY_MAX_DELAY_MS=30000

# === 하이브리드 응답 설정 (기본값 사용 시 생략 가능) ===
# HYBRID_RESPONSE_ENABLED=true        # false로 설정하면 기존 인라인 방식 유지
# HYBRID_THRESHOLD_CHARS=2000         # 이 글자 수 초과 시 파일 저장
# HYBRID_ALWAYS_SAVE_WORKFLOWS=true   # 다중 전문가 워크플로우는 항상 파일 저장
# HYBRID_CLEANUP_MAX_AGE_MS=86400000  # 24시간 후 자동 정리
# HYBRID_PREVIEW_LINES=5              # 요약에 포함할 미리보기 줄 수
