# LLM Router MCP 환경 설정 예시
#
# 필수 키는 없다. 모든 값에 기본값이 있으며 CLI 인증은 각 CLI가 직접 관리한다.
#   codex  → `codex login`
#   agy    → `agy` 최초 실행 시 브라우저 인증
#   claude → Claude Code 구독 인증 (opt-in 전용)

# === 선택: 외부 API 키 ===
# Exa API 키 (web_search 도구) - https://exa.ai
# EXA_API_KEY=

# Context7 API 키 (get_library_docs 도구) - https://context7.com
# CONTEXT7_API_KEY=

# === CLI 도구 경로 (PATH에 있으면 생략 가능) ===
# CLI_CODEX_PATH=codex
# CLI_CLAUDE_PATH=claude
#
# Antigravity CLI(agy) — Google 계열 유일 프로바이더.
# Gemini CLI(@google/gemini-cli)는 2026-06-18 공식 종료되어 이 프로젝트에서 제거됨.
# Windows 기본 설치 경로: %LOCALAPPDATA%\agy\bin\agy.exe
# CLI_AGY_PATH=agy
# (구버전 호환 별칭: CLI_ANTIGRAVITY_PATH)

# === 전문가별 모델 오버라이드 ===
# 값은 model-registry.ts의 MODELS에 등록된 슬러그여야 한다. 아니면 부팅이 실패한다.
#
# codex : gpt-5.5
# agy   : gemini-3.1-pro-high, gemini-3.1-pro-low,
#         gemini-3.6-flash-high/medium/low, gemini-3.5-flash-high/medium/low,
#         gpt-oss-120b-medium,
#         claude-opus-4-6-thinking, claude-sonnet-4-6   ← scarce (기본값으로 쓰지 말 것)
# claude: opus, sonnet                                   ← scarce (사용자 본인 한도 소모)
#
# MODEL_STRATEGIST=gpt-5.5
# MODEL_CODEREVIEW=gemini-3.1-pro-high
# MODEL_MOMUS=gemini-3.1-pro-high
# MODEL_GEMINI_BLANK_2=gemini-3.6-flash-high
# ... MODEL_<전문가ID 대문자> 형식으로 18명 전부 지정 가능

# === Claude opt-in ===
# Claude는 어떤 전문가의 기본 모델도 아니다. consult_expert 등에
# model: "opus" 를 명시할 때만 도달하며, 한도 소진 시 전문가 기본 모델로 자동 강등된다.
# claude -p 호출당 비용 상한 (USD). 0이면 상한 없음.
# CLAUDE_MAX_BUDGET_USD=1.0

# === 캐시 ===
# CACHE_ENABLED=true
# CACHE_TTL_MS=1800000        # 30분
# CACHE_MAX_SIZE=100

# === 재시도 ===
# RETRY_MAX=3
# RETRY_BASE_DELAY_MS=1000
# RETRY_MAX_DELAY_MS=30000

# === 동시성 (프로바이더별) ===
# 모델별 상한은 model-registry.ts가 관리한다.
# CONCURRENCY_CODEX=5         # 구버전 별칭: CONCURRENCY_OPENAI
# CONCURRENCY_AGY=10          # 구버전 별칭: CONCURRENCY_GOOGLE
# CONCURRENCY_CLAUDE=2

# === 하이브리드 응답 (긴 응답을 파일로 저장) ===
# HYBRID_RESPONSE_ENABLED=true
# HYBRID_THRESHOLD_CHARS=2000
# HYBRID_ALWAYS_SAVE_WORKFLOWS=true
# HYBRID_CLEANUP_MAX_AGE_MS=86400000
# HYBRID_PREVIEW_LINES=5

# === 대시보드 ===
# DASHBOARD_ENABLED=false     # 기본 활성화
